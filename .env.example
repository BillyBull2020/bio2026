# BioDynamX Choice OS — environment.
# Copy to your shell or a secret manager. Never commit real values.

# Console
CHOICE_CONSOLE_USER=biodynamx
CHOICE_CONSOLE_PASS=change-me-to-a-long-password
CHOICE_PUBLIC_URL=https://os.example.com

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional: use a Messaging Service instead of a single number
TWILIO_MESSAGING_SERVICE_SID=

# Resend email
RESEND_API_KEY=
RESEND_FROM="Your Company <hello@example.com>"

# Generic webhook fallback (Zapier, n8n, Make, your own worker)
CHOICE_WEBHOOK_URL=
CHOICE_WEBHOOK_TOKEN=
CHOICE_WEBHOOK_TIMEOUT_MS=8000

# Hermes read-only ops analyst
HERMES_BIN=C:\Users\you\AppData\Local\hermes\bin\hermes.exe
HERMES_PROVIDER=google
HERMES_MODEL=gemini-3.8-flash

# Pilot holdout: 0.15 = 15% of eligible contacts get no outbound marketing.
# Leave unset for the demo; set it for a real pilot.
# CHOICE_HOLDOUT_PCT=0.15
# CHOICE_EXPERIMENT_ID=pilot-01

# Optional
# CALENDAR_WEBHOOK_URL=
# CHOICE_LLM_PROVIDER=
# CHOICE_LLM_MODEL=
# CHOICE_LLM_API_KEY=
